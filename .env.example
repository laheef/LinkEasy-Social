# LinkEasy Social — portable configuration
# A matching .env is included in the complete distribution.
# Keep .env OUTSIDE the public document root. Do not commit real credentials.
# Blank provider credentials disable those integrations; they are NOT live-ready.

APP_NAME="LinkEasy Social"
APP_URL="https://laheef.dev"
APP_ENV="production"
APP_DEBUG="false"
APP_TIMEZONE="UTC"

# Blank DSN uses <project>/storage/linkeasy.sqlite (schema auto-initializes).
# For Hostinger MySQL, configure a NEW database, then run php tools/migrate.php:
# DATABASE_DSN="mysql:host=localhost;dbname=u123_social;charset=utf8mb4"
DATABASE_DSN=""
DATABASE_USER=""
DATABASE_PASS=""

# Google OAuth web application. Leave redirect blank to derive from APP_URL.
# Console redirect: https://YOURDOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# PayPal: use matching sandbox/live credentials, plan IDs and webhook ID.
# Webhook: https://YOURDOMAIN/billing/paypal/webhook
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_MONTHLY_ID=""
PAYPAL_PLAN_YEARLY_ID=""

# log = no email delivery. Configure smtp and test before public launch.
# Hostinger mailbox: use the SMTP host shown in your mailbox settings.
# Common combination: smtp.hostinger.com, 465, ssl (or 587, tls).
MAIL_DRIVER="log"
MAIL_FROM_ADDRESS="hello@laheef.dev"
MAIL_FROM_NAME="LinkEasy Social"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_USER=""
SMTP_PASS=""

SUPPORT_EMAIL="support@laheef.dev"
PRICE_MANAGED_MONTHLY="19"
PRICE_MANAGED_YEARLY="190"

# Official profile URLs. Blank values show non-clickable footer icons.
SOCIAL_INSTAGRAM_URL=""
SOCIAL_FACEBOOK_URL=""
SOCIAL_TIKTOK_URL=""
SOCIAL_LINKEDIN_URL=""
SOCIAL_YOUTUBE_URL=""
SOCIAL_X_URL=""

# Legacy optional value, not used by BYO API pricing.
GITHUB_URL=""

# Engineering-audit hardening. Never trust forwarded headers from arbitrary peers.
APP_FORCE_HTTPS="true"
TRUSTED_PROXY_IPS=""
# Payments stay explicitly disabled until real sandbox acceptance tests pass.
PAYPAL_ENABLED="false"
# Diagnostic email bodies only in local/test environments; never in production.
MAIL_LOG_CONTENT="false"
# Cron required: php tools/worker.php --max-jobs=20 --max-seconds=45
